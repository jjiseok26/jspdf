{
  "name": "jspdf-app",
  "productName": "JSPDF",
  "version": "0.1.4",
  "description": "JSPDF - Windows desktop PDF editor",
  "main": "src/main/main.js",
  "author": "jiseok",
  "license": "MIT",
  "copyright": "Copyright © 2026 jiseok",
  "scripts": {
    "start": "npm run icon && electron .",
    "smoke": "electron scripts/smoke.js",
    "dist": "powershell -ExecutionPolicy Bypass -File scripts/generate-icon.ps1 && electron-builder --win nsis",
    "icon": "powershell -ExecutionPolicy Bypass -File scripts/generate-icon.ps1"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.jspdf.app",
    "productName": "JSPDF",
    "icon": "build/icon.ico",
    "copyright": "Copyright © 2026 jiseok",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "src/**/*",
      "node_modules/pdfjs-dist/build/**/*",
      "node_modules/pdfjs-dist/web/**/*",
      "node_modules/pdf-lib/dist/pdf-lib.min.js",
      "node_modules/tesseract.js/dist/**/*",
      "node_modules/tesseract.js-core/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "JSPDF",
        "description": "JSPDF",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "JSPDF",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "JSPDF",
      "uninstallDisplayName": "JSPDF",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
